{
  "name": "barnameh",
  "productName": "Barresan",
  "version": "1.0.3",
  "description": "Waybill management software",
  "author": "Saeed Fadaeian",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "ir.saeidpix.barnameh",
    "productName": "Barresan",
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "backup.js",
      "app/**",
      "build/icon.png",
      "updater.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "باررسان",
      "artifactName": "Barresan-Setup-${version}-${arch}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1065"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": [],
    "npmRebuild": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/saeidpix/vahdat/releases/latest/download/"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "9.6.0",
    "electron-updater": "6.2.0"
  }
}
