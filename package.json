{
  "name": "autobenz-vahdat",
  "productName": "Autobenz Vahdat",
  "version": "1.0.0",
  "description": "Autobenz Vahdat waybill software",
  "author": "Saeed Fadaeian",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "ir.autobenz.vahdat",
    "productName": "Autobenz Vahdat",
    "files": [
      "main.js",
      "preload.js",
      "storage.js",
      "backup.js",
      "app/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "\u0627\u062a\u0648\u0628\u0646\u0632 \u0648\u062d\u062f\u062a",
      "artifactName": "Autobenz-Vahdat-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1065"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "extraResources": []
  },
  "dependencies": {
    "better-sqlite3": "9.6.0"
  }
}